
@{
    ViewBag.Title = "SweerAlert";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Scripts/jquery-3.7.0.js"></script>

<button class="btn btn-primary" id="btn1">Button 1</button>
<button class="btn btn-warning" id="btn2">Button 2</button>

<script>
    $('#btn1').click(function () {
        Swal.fire("Merhaba Mvc Proje Kampı");
    });
</script>
<script>
    $('#btn2').click(function () {
        Swal.fire({
            title: "Mvc Proje Kampı!",
            icon: "success",
            draggable: true
        });
    });
</script>